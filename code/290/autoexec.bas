10 REM 290 PRIME COUNTER
20 SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,1,1:CLS
25 DEFINT A-Z
30 N=999:DIM F(N)
40 PRINT "PRIME COUNTER"
50 PRINT "SIEVE OF ERATOSTHENES TO ";N
60 PRINT
70 C=0
80 FOR P=2 TO N
90 IF F(P) THEN 160
100 C=C+1:PRINT MID$(STR$(P),2);" ";
110 IF C MOD 10=0 THEN PRINT
120 IF P>N/P THEN 160
130 FOR M=P*P TO N STEP P
140 F(M)=1
150 NEXT M
160 NEXT P
170 PRINT:PRINT
180 PRINT "COUNT ";C;" PRIMES <= ";N
190 PRINT "SPACE=RECOUNT  Q=END"
200 A$=INKEY$:IF A$="" THEN 200
210 IF A$="Q" OR A$="q" THEN 240
220 IF A$=" " THEN RUN
230 GOTO 200
240 CLS:END
