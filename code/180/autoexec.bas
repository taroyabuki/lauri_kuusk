10 REM 180 FAST CATERPILLAR GAME
20 SCREEN 0:WIDTH 40:KEY OFF:COLOR 15,2,2:CLS
25 DEFINT A-Z
30 R=RND(-TIME):NL=2:NB=2:MX=30:DIM X(MX),Y(MX),P(MX)
35 DIM FX(NL),FY(NL),F(NL),BX(NB),BY(NB),B(NB)
36 DIM XD(8),YD(8),PD(8)
37 FOR I=0 TO 8:READ XD(I),YD(I),PD(I):NEXT I
38 DATA 0,0,0,0,-1,-40,1,0,1,1,0,1,1,0,1,0,1,40,-1,0,-1,-1,0,-1,-1,0,-1
40 L=4:ML=30:T=0:DX=1:DY=0:DP=1:S=0:C=0
50 FOR I=0 TO L-1:X(I)=7+I:Y(I)=12:P(I)=Y(I)*40+X(I):NEXT I
120 LOCATE 0,0:PRINT "CATERPILLAR  CURSORS  SPACE=END"
130 GOSUB 500:GOSUB 590:GOSUB 530:GOSUB 560
140 K=STICK(0):IF K=0 THEN K=STICK(1)
145 A$=INKEY$:IF A$=" " THEN 490
150 IF K=0 THEN 190
160 U=XD(K):V=YD(K):IF U=-DX AND V=-DY THEN 190
170 DX=U:DY=V:DP=PD(K)
190 H=T+L-1:IF H>MX THEN H=H-MX-1
200 NX=X(H)+DX:NY=Y(H)+DY:NP=P(H)+DP
210 IF NX<1 THEN NX=38 ELSE IF NX>38 THEN NX=1
211 IF NY<3 THEN NY=22 ELSE IF NY>22 THEN NY=3
212 NP=NY*40+NX
220 CC=VPEEK(NP):IF CC=66 THEN M=2:GOTO 1000
225 IF CC=111 AND NP<>P(T) THEN M=3:GOTO 1000
230 E=0:IF CC=43 THEN E=1:GOSUB 850
240 IF E=1 AND L<ML THEN L=L+1:GOTO 270
250 VPOKE P(T),32
260 T=T+1:IF T>MX THEN T=0
270 H=T+L-1:IF H>MX THEN H=H-MX-1
280 X(H)=NX:Y(H)=NY:P(H)=NP:VPOKE NP,111
290 IF E THEN S=S+10:GOSUB 500
300 IF E THEN I=Z:GOSUB 900:FX(I)=RX:FY(I)=RY:F(I)=RA:VPOKE RA,43
310 C=C+1:IF C<2 THEN 140
320 C=0
330 FOR I=0 TO NB
340 OX=BX(I):OY=BY(I):O=B(I):GOSUB 760
350 XX=OX+INT(RND(1)*3)-1:YY=OY+INT(RND(1)*3)-1
360 IF XX<1 THEN XX=1 ELSE IF XX>38 THEN XX=38
370 IF YY<3 THEN YY=3 ELSE IF YY>22 THEN YY=22
380 A=YY*40+XX:CC=VPEEK(A)
390 IF CC=111 THEN M=4:GOTO 1000
400 IF CC=66 THEN BX(I)=OX:BY(I)=OY:B(I)=O:VPOKE O,66:GOTO 420
410 BX(I)=XX:BY(I)=YY:B(I)=A:VPOKE A,66
420 NEXT I:GOTO 140
490 CLS:END
500 LOCATE 0,1:PRINT "SCORE ";S;" LEN ";L;"/";ML;" ";
505 PRINT "LEAF ";NL+1;" BIRD ";NB+1;" ";
510 RETURN
530 FOR I=0 TO NL:GOSUB 900:FX(I)=RX:FY(I)=RY:F(I)=RA:VPOKE RA,43:NEXT I:RETURN
560 FOR I=0 TO NB:GOSUB 900:BX(I)=RX:BY(I)=RY:B(I)=RA:VPOKE RA,66:NEXT I:RETURN
590 FOR I=0 TO L-1:VPOKE P(I),111:NEXT I:RETURN
760 VPOKE O,32:FOR Q=0 TO NL:IF O=F(Q) THEN VPOKE O,43:Q=NL
770 NEXT Q:RETURN
850 FOR Q=0 TO NL:IF NP=F(Q) THEN Z=Q:Q=NL
860 NEXT Q:RETURN
900 RX=INT(RND(1)*38)+1:RY=INT(RND(1)*20)+3:RA=RY*40+RX
910 IF VPEEK(RA)<>32 THEN 900
920 RETURN
1000 LOCATE 10,12:PRINT "GAME OVER  SCORE ";S
1005 A$=INKEY$:IF A$<>"" THEN 1005
1010 IF INKEY$="" THEN 1010
1020 GOTO 490
