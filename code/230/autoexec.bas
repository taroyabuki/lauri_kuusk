10 REM 230 FIREWORKS MSX2 ASM
20 CLEAR 200,&HBFFF:SCREEN 5:KEY OFF:COLOR 15,1,1:CLS
30 A=&HD100:FOR I=0 TO 1016:READ B:POKE A+I,B:NEXT I
40 C=&HC000:DEFUSR=&HD100:R=RND(-TIME)
50 IF INKEY$=" " THEN 190
60 N=INT(RND(1)*3)+1:POKE C+13,N
70 FOR J=0 TO N-1:O=16+J*4:S=INT(RND(1)*5)+4:M=7*S
80 POKE C+O,INT(RND(1)*(256-M*2))+M
90 POKE C+O+1,INT(RND(1)*(108-M))+M
100 K=INT(RND(1)*3):CO=10
110 IF K=1 THEN CO=8
120 IF K=2 THEN CO=3
130 POKE C+O+2,CO:POKE C+O+3,S
140 NEXT J
150 D=USR(0)
160 IF PEEK(C+3)<>0 THEN 190
170 GOTO 50
190 SCREEN 0:END
