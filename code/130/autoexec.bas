10 REM 130 SCROLL DRAGON FIRE
20 SCREEN 0:WIDTH 40:KEY OFF:COLOR 15,1,1:CLS
25 DEFINT A-Z
30 R=RND(-TIME):L=5:F=2:HY=16:HX=20:S=0:B$=SPACE$(39)
35 DIM DX(L),BA(L),DA(L)
40 FOR I=0 TO L-1:DX(I)=HX:BA(I)=(HY-I)*40:NEXT I
50 LOCATE 0,0:PRINT "DRAGON FIRE"
60 LOCATE 0,1:PRINT "LEFT/RIGHT  SPACE=END"
70 GOSUB 220
80 K=STICK(0):IF K=0 THEN K=STICK(1)
85 A$=INKEY$:IF A$=" " THEN 350
90 IF STRIG(0) THEN 350
100 GOSUB 250:NHX=HX
110 IF K=3 OR K=2 OR K=4 THEN NHX=HX+1
115 IF A$=CHR$(28) THEN NHX=HX+1
120 IF K=7 OR K=6 OR K=8 THEN NHX=HX-1
125 IF A$=CHR$(29) THEN NHX=HX-1
130 IF NHX<0 THEN NHX=0
140 IF NHX>38 THEN NHX=38
150 FOR I=L-1 TO 1 STEP -1
160 DX(I)=DX(I-1)
170 NEXT I
180 HX=NHX:DX(0)=HX
190 GOSUB 280
200 FOR I=0 TO L-1
205 DA(I)=BA(I)+DX(I)
210 IF VPEEK(DA(I))=64 THEN 330
215 NEXT I:GOSUB 220:S=S+1:GOTO 80
220 FOR I=L-1 TO 0 STEP -1
230 DA(I)=BA(I)+DX(I):VPOKE DA(I),42
240 NEXT I:RETURN
250 FOR I=L-1 TO 0 STEP -1
260 VPOKE DA(I),32
270 NEXT I:RETURN
280 L$=B$
290 FOR P=1 TO F:X=INT(RND(1)*39)+1:MID$(L$,X,1)="@":NEXT P
300 LOCATE 0,23:PRINT L$
310 RETURN
330 LOCATE 9,12:PRINT "GAME OVER SCORE ";S
340 IF INKEY$="" THEN 340
350 CLS:END
