10 REM 140 CAR DODGE
20 SCREEN 0:WIDTH 40:KEY OFF:COLOR 15,1,1:CLS
25 DEFINT A-Z
30 R=RND(-TIME):L=1:N=3:S=0:SP=25
35 DIM LX(2),LA(2),EL(N),EY(N),EA(N),YA(23)
40 FOR Y=0 TO 23:YA(Y)=Y*40:NEXT Y
50 LX(0)=17:LX(1)=20:LX(2)=23
60 FOR I=0 TO 2:LA(I)=YA(22)+LX(I):NEXT I
70 FOR I=0 TO N
80 EL(I)=INT(RND(1)*3):IF EL(I)>2 THEN EL(I)=2
90 EY(I)=3-I*5
100 IF EY(I)>=3 THEN EA(I)=YA(EY(I))+LX(EL(I))
110 NEXT I
120 LOCATE 0,0:PRINT "CAR DODGE  LEFT/RIGHT  SPACE=END"
130 FOR Y=3 TO 23
140 LOCATE 14,Y:PRINT "|";:LOCATE 26,Y:PRINT "|";
150 NEXT Y
160 GOSUB 500:GOSUB 530:GOSUB 560
170 K=STICK(0):IF K=0 THEN K=STICK(1)
180 A$=INKEY$:IF A$=" " THEN 490
190 IF STRIG(0) THEN 490
200 VPOKE LA(L),32:U=0
210 IF K=3 OR K=2 OR K=4 OR A$=CHR$(28) THEN L=L+1
220 IF K=7 OR K=6 OR K=8 OR A$=CHR$(29) THEN L=L-1
230 IF L<0 THEN L=0
240 IF L>2 THEN L=2
250 IF VPEEK(LA(L))=86 THEN 470
260 FOR I=0 TO N
270 IF EY(I)>=3 AND EY(I)<=23 THEN VPOKE EA(I),32
280 NEXT I
290 FOR I=0 TO N
300 EY(I)=EY(I)+1
310 IF EY(I)<=23 THEN 350
320 EY(I)=3-INT(RND(1)*6):EL(I)=INT(RND(1)*3)
330 S=S+10:U=1:IF SP>12 THEN SP=SP-1
340 IF EL(I)>2 THEN EL(I)=2
350 IF EY(I)<3 THEN 380
360 EA(I)=YA(EY(I))+LX(EL(I))
370 VPOKE EA(I),86
380 NEXT I
390 IF VPEEK(LA(L))=86 THEN 470
400 VPOKE LA(L),65
410 IF U=1 THEN GOSUB 500
420 FOR W=1 TO SP:NEXT W:GOTO 170
470 LOCATE 12,12:PRINT "CRASH  SCORE ";S
480 IF INKEY$="" THEN 480
490 CLS:END
500 LOCATE 0,1:PRINT "SCORE ";S;" SPEED ";50-SP;"   ";
510 RETURN
530 VPOKE LA(L),65
540 RETURN
560 FOR I=0 TO N
570 IF EY(I)>=3 AND EY(I)<=23 THEN VPOKE EA(I),86
580 NEXT I:RETURN
