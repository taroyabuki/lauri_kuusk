10 REM 190 PIONEER SCRAP COLLECTOR
20 CLEAR 200,&HBFFF:SCREEN 2:KEY OFF:COLOR 15,1,1:CLS
25 DEFINT A-Z
30 R=RND(-TIME):PX=120:PY=92:EX=24:EY=152:S=0:T=900
40 N=13:M=5:Q=0:EP=0:EV=51:EA=1:DIM SX(N),SY(N),D(N)
50 OPEN "GRP:" FOR OUTPUT AS #1
51 PRESET (0,0):PRINT #1,"loading..."
52 A=&HD100:RESTORE 3000
54 FOR I=0 TO 718:READ B:POKE A+I,B:NEXT I
56 DEFUSR=&HD100
60 FOR I=0 TO N:D(I)=1:NEXT I
65 FOR I=0 TO M-1:GOSUB 600:SX(I)=X:SY(I)=Y
66 D(I)=0:Q=Q+1:GOSUB 850:NEXT I
70 GOSUB 500:GOSUB 700:GOSUB 800
80 K=STICK(0):IF K=0 THEN K=STICK(1)
90 A$=INKEY$
100 OX=PX:OY=PY
110 IF K=1 OR K=2 OR K=8 OR A$=CHR$(30) THEN PY=PY-4
120 IF K=5 OR K=4 OR K=6 OR A$=CHR$(31) THEN PY=PY+4
130 IF K=7 OR K=6 OR K=8 OR A$=CHR$(29) THEN PX=PX-4
140 IF K=3 OR K=2 OR K=4 OR A$=CHR$(28) THEN PX=PX+4
150 IF PX<8 THEN PX=8 ELSE IF PX>247 THEN PX=247
160 IF PY<29 THEN PY=29 ELSE IF PY>183 THEN PY=183
170 IF OX<>PX OR OY<>PY THEN GOSUB 750:GOSUB 700
175 IF ABS(PX-EX)<8 AND ABS(PY-EY)<8 THEN 430
180 FOR I=0 TO N
190 IF D(I) THEN 230
200 IF ABS(PX-SX(I))>7 OR ABS(PY-SY(I))>7 THEN 230
210 D(I)=1:Q=Q-1:S=S+10:GOSUB 850
220 GOSUB 500
230 NEXT I
240 IF Q<N AND T MOD 45=0 THEN GOSUB 660
250 REM
260 EV=EV+EA:EP=EP+EV
265 IF EP<256 THEN 360
270 EP=EP-256:ZX=EX:ZY=EY:GOSUB 820
280 NX=EX:NY=EY
290 IF RND(1)<.25 THEN GOSUB 900 ELSE GOSUB 950
300 IF NX<8 THEN NX=8 ELSE IF NX>247 THEN NX=247
310 IF NY<24 THEN NY=24 ELSE IF NY>183 THEN NY=183
320 EX=NX:EY=NY:GOSUB 800
330 IF ABS(PX-EX)<8 AND ABS(PY-EY)<8 THEN 430
340 IF EP>=256 THEN 270
350 GOTO 370
360 REM
370 T=T-1:IF T<=0 THEN 430
380 IF T MOD 20=0 THEN GOSUB 500
390 GOTO 80
430 LINE (64,80)-(191,111),1,BF
432 PRESET (88,88):PRINT #1,"GAME OVER"
434 PRESET (84,98):PRINT #1,"SCORE ";S
440 A$=INKEY$:IF A$<>"" THEN 440
450 IF INKEY$="" THEN 450
460 CLOSE #1:SCREEN 0:CLS:END
500 LINE (0,0)-(255,15),1,BF
505 PRESET (0,0):PRINT #1,"SCORE ";S;" SCRAP ";Q
510 PRESET (0,8):PRINT #1,"TIME ";T;" CURSORS":RETURN
600 X=INT(RND(1)*220)+18:Y=INT(RND(1)*140)+34
610 IF ABS(X-PX)<12 AND ABS(Y-PY)<16 THEN 600
620 IF ABS(X-EX)<12 AND ABS(Y-EY)<12 THEN 600
630 F=0:FOR J=0 TO N
640 IF D(J)=0 AND ABS(X-SX(J))<10 AND ABS(Y-SY(J))<10 THEN F=1
650 NEXT J:IF F THEN 600 ELSE RETURN
660 FOR I=0 TO N
670 IF D(I)=0 THEN 695
680 GOSUB 600:SX(I)=X:SY(I)=Y:D(I)=0:Q=Q+1:GOSUB 850
690 I=N
695 NEXT I:RETURN
700 POKE &HD001,PX:POKE &HD002,PY:POKE &HD000,1:U=USR(0):RETURN
750 POKE &HD001,OX:POKE &HD002,OY:POKE &HD000,2:U=USR(0):RETURN
800 POKE &HD001,EX:POKE &HD002,EY:POKE &HD000,3:U=USR(0):RETURN
820 POKE &HD001,ZX:POKE &HD002,ZY:POKE &HD000,4:U=USR(0):RETURN
850 POKE &HD001,SX(I):POKE &HD002,SY(I):POKE &HD000,5:U=USR(0):RETURN
900 R=INT(RND(1)*4)
910 IF R=0 THEN NX=EX-4
920 IF R=1 THEN NX=EX+4
930 IF R=2 THEN NY=EY-4
940 IF R=3 THEN NY=EY+4
945 RETURN
950 IF PX<EX THEN NX=EX-4 ELSE IF PX>EX THEN NX=EX+4
960 IF PY<EY THEN NY=EY-4 ELSE IF PY>EY THEN NY=EY+4
970 RETURN
