10 REM 200 ICE TRAY GAME
20 SCREEN 2:KEY OFF:COLOR 15,1,1:CLS
25 DEFINT A-Z
27 OPEN "GRP:" FOR OUTPUT AS #1
30 R=RND(-TIME):DIM F(5)
40 TX=90:WY=16:WX=INT(RND(1)*230)+10:S=0:C=0
45 OS=-1:OC=-1
50 GOSUB 300:GOSUB 500
60 K=STICK(0):IF K=0 THEN K=STICK(1)
65 A$=INKEY$:IF A$=" " THEN 260
70 OT=TX:MV=0
80 IF K=7 OR K=6 OR K=8 OR A$="A" OR A$="a" THEN TX=TX-8
90 IF K=3 OR K=2 OR K=4 OR A$="D" OR A$="d" THEN TX=TX+8
100 IF TX<0 THEN TX=0
110 IF TX>180 THEN TX=180
120 IF TX<>OT THEN MV=1:GOSUB 360:GOSUB 300
130 PSET (WX,WY),1
140 WY=WY+8
145 IF MV THEN WY=WY+4
150 IF WY>148 THEN GOSUB 210:GOTO 180
160 PSET (WX,WY),11
170 IF S<>OS OR C<>OC THEN GOSUB 500
180 REM
190 IF MV THEN 200
195 FOR W=1 TO 20:NEXT W
200 GOTO 60
210 IF WX<TX OR WX>=TX+72 THEN 220
212 H=INT((WX-TX)/12)
214 IF F(H) THEN 220
216 F(H)=1:C=C+1:GOSUB 300:GOSUB 500
218 IF C=6 THEN GOSUB 600
220 WY=16:WX=INT(RND(1)*230)+10
230 RETURN
240 REM
250 REM
260 CLOSE #1:SCREEN 0:END
270 REM
280 LINE (64,80)-(191,111),1,BF
285 PRESET (84,92):PRINT #1,"ICE COMPLETE"
290 IF INKEY$="" THEN 290 ELSE CLOSE #1:SCREEN 0:END
300 LINE (TX,150)-(TX+72,170),7,B
310 FOR I=1 TO 5:LINE (TX+I*12,150)-(TX+I*12,170),7:NEXT I
320 FOR I=0 TO 5
330 IF F(I)=1 THEN LINE (TX+I*12+2,153)-(TX+I*12+10,167),11,BF
340 NEXT I
350 RETURN
360 LINE (OT,148)-(OT+75,174),1,BF
370 RETURN
500 LINE (0,0)-(255,15),1,BF
505 PRESET (0,0):PRINT #1,"SCORE ";S;" ICE ";C;"/6"
510 OS=S:OC=C:RETURN
600 S=S+100:C=0
610 FOR I=0 TO 5:F(I)=0:NEXT I
620 LINE (TX,148)-(TX+75,174),1,BF
630 GOSUB 300:GOSUB 500:RETURN
