10 REM 110 TEXT SNOW DEMO
20 SCREEN 0:WIDTH 40:KEY OFF:COLOR 15,1,1:CLS
25 DEFINT A-Z
30 R=RND(-TIME):N=18:DIM A(N)
40 FOR I=0 TO N
50 X=INT(RND(1)*40):Y=INT(RND(1)*20)+2
60 A(I)=Y*40+X:VPOKE A(I),219
70 NEXT I
80 LOCATE 0,0:PRINT "BLOCK SNOW  SPACE=END"
90 FOR I=0 TO N
100 VPOKE A(I),32
110 A(I)=A(I)+40
120 IF A(I)>959 THEN A(I)=80+INT(RND(1)*40)
130 VPOKE A(I),219
140 NEXT I
150 IF STRIG(0) THEN 180
160 IF INKEY$=" " THEN 180
170 GOTO 90
180 COLOR 15,1,1:CLS:END
