10 REM 220 IMAGINARY ROCKET MSX2
20 CLEAR 200,&HBFFF:SCREEN 5:KEY OFF:COLOR 15,1,1:CLS
25 OPEN "GRP:" FOR OUTPUT AS #1:PRESET (0,0):PRINT #1,"loading..."
30 A=&HD100:FOR I=0 TO 744:READ B:POKE A+I,B:NEXT I
40 C=&HC000:EO=&HC020:MO=&HC0E0:P=3.14159265
50 FOR I=0 TO 95:A=2*P*I/96
60 POKE EO+I*2,INT(128+58*COS(A)+.5)
70 POKE EO+I*2+1,INT(96+42*SIN(A)+.5):NEXT I
80 FOR I=0 TO 127:A=2*P*I/128
90 POKE MO+I*2,INT(128+88*COS(A)+.5)
100 POKE MO+I*2+1,INT(96+64*SIN(A)+.5):NEXT I
110 DEFUSR=&HD100:POKE C,0:D=USR(0)
120 FOR F=0 TO 256
130 U=F/256:V=1-U
140 X=INT(V*V*V*114+3*V*V*U*170+3*V*U*U*55+U*U*U*94+.5)
150 Y=INT(V*V*V*133+3*V*V*U*95+3*V*U*U*65+U*U*U*155+.5)
160 J=30+INT(F*3/8):IF J>95 THEN J=J-96
170 K=104+F\4:IF K>127 THEN K=K-128
180 POKE C+1,X:POKE C+2,Y
190 POKE C+3,PEEK(EO+J*2):POKE C+4,PEEK(EO+J*2+1)
200 POKE C+5,PEEK(MO+K*2):POKE C+6,PEEK(MO+K*2+1)
210 POKE C,1:D=USR(0)
220 IF INKEY$<>"" THEN 250
230 NEXT F
240 IF INKEY$="" THEN 240
250 CLOSE #1:SCREEN 0:END
