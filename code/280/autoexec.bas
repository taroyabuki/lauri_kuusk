10 REM 280 MSX2 SQUARE TABLE MULTIPLY
20 CLEAR 200,&HCFFF:SCREEN 5:KEY OFF:COLOR 15,1,1:CLS
25 OPEN "GRP:" FOR OUTPUT AS #1
30 PRESET (0,0):PRINT #1,"SQUARE TABLE MULTIPLY"
40 PRESET (0,8):PRINT #1,"AB=((A+B)^2-(A-B)^2)/4"
50 A=&HD100:FOR I=0 TO 449:READ B:POKE A+I,B:NEXT I
60 DEFUSR=&HD100:POKE &HD00A,0:D=USR(0)
65 PRESET (0,16):PRINT #1,"benchmarking..."
70 P=PEEK(&HD002)+256*PEEK(&HD003):T=PEEK(&HD012)+256*PEEK(&HD013)
80 N=500:TIME=0:S=0:X=1:Y=7
90 FOR I=1 TO N
100 M=X*Y:S=S+M:IF S>65535 THEN S=S-65536
110 X=X+17:IF X>255 THEN X=X-256
120 Y=Y+29:IF Y>255 THEN Y=Y-256
130 NEXT I:TB=TIME
140 POKE &HD006,N-INT(N/256)*256:POKE &HD007,INT(N/256)
150 POKE &HD00A,1:TIME=0:D=USR(0):TZ=TIME
160 SZ=PEEK(&HD004)+256*PEEK(&HD005):POKE &HD00A,0
170 LINE (0,168)-(255,211),1,BF
180 PRESET (0,172):PRINT #1,"37*123=";P;" TABLE ";T
190 PRESET (0,180):PRINT #1,"BASIC ";TB;" CHECK ";S
200 PRESET (0,188):PRINT #1,"Z80 ";TZ;" CHECK ";SZ
210 IF TZ=0 THEN PRESET (0,196):PRINT #1,"Z80 <1/60 SEC":GOTO 230
220 PRESET (0,196):PRINT #1,"BASIC/Z80 ";TB/TZ
230 PRESET (0,204):PRINT #1,"PRESS RETURN"
240 A$=INKEY$:IF A$<>"" THEN 240
250 A$=INKEY$:IF A$<>CHR$(13) THEN 250
260 CLOSE #1:END
