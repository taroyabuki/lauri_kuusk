10 REM 120 ADDITION PRACTICE
20 SCREEN 0:WIDTH 40:KEY OFF:COLOR 15,1,1:CLS
30 R=RND(-TIME):S=0:N=0
40 PRINT "ADDITION PRACTICE"
50 PRINT "3 QUESTIONS. ENTER 999 TO END."
60 A=INT(RND(1)*50):B=INT(RND(1)*50)
70 N=N+1
80 PRINT
90 PRINT "QUESTION ";N;"/3"
100 PRINT A;"+";B;"=?";
110 INPUT C
120 IF C=999 THEN 220
130 IF C=A+B THEN PRINT "OK":S=S+1:GOTO 160
140 PRINT "NO. ANSWER IS ";A+B
150 BEEP
160 IF N>=3 THEN 200
170 FOR W=1 TO 350:NEXT W
180 GOTO 60
190 REM
200 PRINT
210 PRINT "SCORE ";S;"/3"
220 END
